<%- include("../partials/header.ejs") %>

<body>
    <div class="container">
    
        <div class="text-center">
            <h2 class="card-title">Editing Post...</h2>
        </div>

        <div class="card">
            <div class="card-body">
                <form action="/POST_ID/<%= post.blog_id %>" method="POST">

                    <div class="mb-3">
                        <label for="title">Title: </label>
                        <input type="text" id="title" name="title" value="<%= post.title %>" required>
                    </div>

                    <div class="mb-3">
                        <label for="body">Blog Content: </label>
                        <input type="text" id="body" name="body" value="<%= post.body %>" required>
                    </div>

                    <button class="btn btn-success" value="Save Edits">Save Edits</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
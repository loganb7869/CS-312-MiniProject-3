<%- include("../partials/header.ejs") %>

<body>
    <div class="container">
    
        <div class="text-center">
            <h2 class="card-title">Editing Post...</h2>
        </div>

        <div class="card">
            <div class="card-body">
                <form action="/POST_ID/<%= post.id %>" method="POST">

                    <div class="mb-3">
                        <label for="userName">Name:</label>
                        <input type="text" id="userName" name="userName" value="<%= post.userName %>" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="blogTitle">Blog Title: </label>
                        <input type="text" id="blogTitle" name="blogTitle" value="<%= post.blogTitle %>" required>
                    </div>

                    <div class="mb-3">
                        <label for="blogContent">Blog Content: </label>
                        <input type="text" id="blogContent" name="blogContent" value="<%= post.blogContent %>" required>
                    </div>
                    
                    <input type="submit" class="btn btn-success" value="Save Edits">
                </form>
            </div>
        </div>
    </div>
</body>
</html>
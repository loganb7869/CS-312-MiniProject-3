<%- include("../partials/header.ejs") %>

<body>
    <div class="container">
        <div class="card">
            <div class="card-body">
                <h2 class="card-title">Blog Post Creation</h2>

                <form action="/new_post" method="POST">

                    <div class="mb-3">
                        <label for="creator_name">Name: <%= userName %></label>
                    </div>

                    <div class="mb-3">
                        <label for="creator_user_id">User ID: <%= userId %></label>
                    </div>

                    <div class="mb-3">
                        <label for="title">Title: </label>
                        <input type="text" id="title" name="title" required>
                    </div>

                    <div class="mb-3">
                        <label for="body">Blog Content: </label>
                        <input type="text" id="body" name="body" required>
                    </div>
                    
                    <button class="btn btn-secondary">Submit Post</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
<%- include("../partials/header.ejs") %>

<body>
    <div class="container">
        <div class="card">
            <div class="card-body">
                <h2 class="card-title text-center">Are you sure you want to delete this post?</h2>
                <div class="d-flex justify-content-center gap-3">
                    <form action="/POST_ID/<%= post.blog_id %>/delete" method="POST">
                        <button type="submit" class="btn btn-success">Yes</button>
                    </form>
                    <a href="/" class="btn btn-danger">No</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
<%- include("../partials/header.ejs") %>

<body>
    <div class="container">

        <div class="text-center">
            <h2>The Blog</h2>
        </div>

        <div class="card mb-2">
            <div class="card-body">
                <% if (userId) { %>
                    <a href="/new_post" class="btn btn-success me-2">New Post</a>
                    <a href="/signout" class="btn btn-danger">Sign Out</a>
                <% } else { %>
                    <a href="/signin" class="btn btn-success me-2">Sign In</a>

                    <a href="/signup" class="btn btn-success">Sign Up</a>
                <% } %>
            </div>
        </div>
    </div>

    <div class="container">

        <div class="text-center mt-3">
            <h2>Recent Posts</h2>
        </div>

        <% blogs.forEach(b => { %>
            <div class="card mb-2">
                <div class="card-body">
                    <h2 class="card-title"><%= b.title %></h2>
                    <p style="font-style:italic;">Created by <%= b.creator_name %> on <%= b.date_created %></p>

                    <div class="card">
                        <div class="card-body">
                            <p><%= b.body %></p>
                        </div>
                    </div>
                    <br>
                    <% if (userId === b.creator_user_id) { %> 
                        <a href="/POST_ID/<%= b.blog_id %>" class="btn btn-success me-2">Edit</a>
                        <a href="/POST_ID/<%= b.blog_id %>/delete" class="btn btn-danger">Delete</a>
                    <% } %>
                </div>
            </div>
        <% }) %>
    </div>
</body>
</html>